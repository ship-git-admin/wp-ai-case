{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site and context scoped ACF mapping, versioned and approved",
  "$id": "https://example.invalid/wp-ai-case/v0.6.2/acf_mapping.schema.json",
  "type": "object",
  "properties": {
    "mapping_id": {
      "type": "string",
      "format": "uuid"
    },
    "mapping_version": {
      "type": "integer",
      "minimum": 1
    },
    "site_scope_id": {
      "type": "string",
      "minLength": 1
    },
    "post_type": {
      "const": "works"
    },
    "context_selector": {
      "type": "object",
      "properties": {
        "post_type": {
          "const": "works"
        },
        "location_rule_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taxonomy": {
                "type": "string",
                "minLength": 1
              },
              "term_id": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "taxonomy",
              "term_id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "post_type",
        "location_rule_fingerprint"
      ],
      "additionalProperties": false
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template_ref": {
      "type": "object",
      "properties": {
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "template_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "template_id",
        "template_version"
      ],
      "additionalProperties": false
    },
    "mapping_status": {
      "enum": [
        "proposed",
        "blocked_drift",
        "proposed_rebuild",
        "validated_local",
        "pending_staging_validation",
        "validated_staging",
        "approved_active",
        "blocked_unsupported",
        "retired"
      ]
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "semantic_slot": {
            "type": "string",
            "minLength": 1
          },
          "field_key": {
            "type": "string",
            "pattern": "^field_[A-Za-z0-9_]+$"
          },
          "field_type": {
            "type": "string",
            "minLength": 1,
            "description": "ACF field type, or 'layout' for a flexible-content layout binding"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "layout_name": {
            "type": "string"
          },
          "transform_id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "editable": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "string"
          },
          "verification": {
            "type": "object",
            "properties": {
              "field_exists": {
                "type": "boolean"
              },
              "type_compatible": {
                "type": "boolean"
              },
              "path_compatible": {
                "type": "boolean"
              },
              "conditions_compatible": {
                "type": "boolean"
              },
              "transform_registered": {
                "type": "boolean"
              }
            },
            "required": [
              "field_exists",
              "type_compatible",
              "path_compatible",
              "conditions_compatible",
              "transform_registered"
            ],
            "additionalProperties": false
          },
          "layout_key": {
            "type": "string",
            "description": "layout bindings only: the ACF layout key (for same_key matching on rebuild)"
          }
        },
        "required": [
          "semantic_slot",
          "field_key",
          "field_type",
          "path",
          "transform_id",
          "editable",
          "confidence",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "validation": {
      "type": "object",
      "properties": {
        "fixture_passed": {
          "type": "boolean"
        },
        "staging_write_read_passed": {
          "type": "boolean"
        },
        "staging_display_passed": {
          "type": "boolean"
        },
        "tested_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tested_context_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "tested_theme_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "theme files fingerprint at staging validation; differs later => display recheck required (save still allowed)"
        }
      },
      "required": [
        "fixture_passed",
        "staging_write_read_passed",
        "staging_display_passed",
        "tested_schema_sha256",
        "tested_context_hash",
        "evidence_ref",
        "verified_at"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "approved_by_user_id": {
          "type": "integer",
          "minimum": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "approved_by_user_id",
        "approved_at",
        "approval_reason"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "problems": {
      "type": "array",
      "description": "blocked_unsupported only: why the rebuild could not be completed (no AI guess)",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "slot",
          "kind",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "mapping_id",
    "mapping_version",
    "site_scope_id",
    "post_type",
    "context_selector",
    "context_hash",
    "schema_sha256",
    "mapping_status",
    "bindings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mapping_status": {
            "const": "approved_active"
          }
        }
      },
      "then": {
        "required": [
          "validation",
          "approval"
        ],
        "properties": {
          "validation": {
            "properties": {
              "fixture_passed": {
                "const": true
              },
              "staging_write_read_passed": {
                "const": true
              },
              "staging_display_passed": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "description": "Bindings are untrusted proposals until verified. PHP requires every approved binding verification boolean true and schema/context hashes to match current runtime; schema cannot compare cross-field equality. v0.6.2: layout_key, validation.tested_theme_fingerprint, problems added."
}
