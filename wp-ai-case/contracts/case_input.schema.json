{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI create or revise request (wire contract)",
  "$id": "https://example.invalid/wp-ai-case/v0.6.2/case_input.schema.json",
  "type": "object",
  "properties": {
    "client_case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "enum": [
        "create",
        "revise_draft"
      ]
    },
    "post_type": {
      "const": "works"
    },
    "post_id": {
      "type": "integer",
      "minimum": 1
    },
    "base_version": {
      "type": "integer",
      "minimum": 1
    },
    "primary_facts": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "string",
          "minLength": 1
        },
        "client_request": {
          "type": "string",
          "minLength": 1
        },
        "work_done": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "cost": {
          "type": "string"
        },
        "materials": {
          "type": "string"
        },
        "building_type": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "overview",
        "client_request",
        "work_done"
      ],
      "additionalProperties": false
    },
    "photo_set_description": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "integer",
            "minimum": 1
          },
          "original_position": {
            "type": "integer",
            "minimum": 0
          },
          "caption": {
            "type": "string"
          },
          "user_phase_hint": {
            "enum": [
              "before",
              "during",
              "after",
              "unknown"
            ]
          }
        },
        "required": [
          "attachment_id",
          "original_position"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "consent_external_ai": {
      "const": true
    },
    "relations": {
      "description": "任意。お客様の声・担当スタッフ（最大3）・監修者の投稿ID。空なら紐付けなし。PHPが投稿タイプ・公開状態を確認する。",
      "type": "object",
      "properties": {
        "customer_voice_post_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "staff": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "post_id": {
                "type": "integer",
                "minimum": 1
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "post_id",
              "comment"
            ],
            "additionalProperties": false
          }
        },
        "supervisor_post_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "customer_voice_post_ids",
        "staff",
        "supervisor_post_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "client_case_id",
    "idempotency_key",
    "mode",
    "post_type",
    "consent_external_ai"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "create"
          }
        }
      },
      "then": {
        "required": [
          "primary_facts",
          "photo_set_description",
          "images"
        ],
        "not": {
          "required": [
            "post_id",
            "base_version"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "revise_draft"
          }
        }
      },
      "then": {
        "required": [
          "post_id",
          "base_version"
        ]
      }
    }
  ],
  "description": "Only requests to an AI-assisted endpoint; local GUI-only edits use TypedPatch and do not require external consent. Duplicate attachment IDs and active-user permission are checked in PHP. v0.6.2: optional relations."
}
