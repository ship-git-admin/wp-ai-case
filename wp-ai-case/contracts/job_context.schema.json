{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable job start snapshot and status",
  "$id": "https://example.invalid/wp-ai-case/v0.5/job_context.schema.json",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "enum": [
        "create",
        "revise_draft"
      ]
    },
    "post_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "base_post_version": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "base_modified_gmt": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mapping_id": {
      "type": "string",
      "format": "uuid"
    },
    "mapping_version": {
      "type": "integer",
      "minimum": 1
    },
    "job_generation": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "reserved",
        "queued",
        "analyzing",
        "proposal_ready",
        "awaiting_user",
        "saving",
        "committed",
        "cancelled",
        "expired",
        "failed",
        "needs_recovery"
      ]
    },
    "quota_month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "quota_reservation_id": {
      "type": "string",
      "format": "uuid"
    },
    "attachment_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "job_id",
    "idempotency_key",
    "mode",
    "post_id",
    "base_post_version",
    "base_modified_gmt",
    "schema_sha256",
    "context_hash",
    "mapping_id",
    "mapping_version",
    "job_generation",
    "status",
    "quota_month",
    "quota_reservation_id",
    "attachment_ids",
    "started_at",
    "expires_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "revise_draft"
          }
        }
      },
      "then": {
        "properties": {
          "post_id": {
            "type": "integer",
            "minimum": 1
          },
          "base_post_version": {
            "type": "integer",
            "minimum": 1
          },
          "base_modified_gmt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "description": "PHP checks base post revision, schema hash, mapping, cancellation/expiration and generation both at job start and immediately before save. No stale result may save. Create jobs start with null post_id and may have a real post_id after commit; PHP enforces that state transition."
}
