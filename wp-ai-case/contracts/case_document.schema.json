{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACF-independent canonical case document",
  "$id": "https://example.invalid/wp-ai-case/v0.6.2/case_document.schema.json",
  "description": "No ACF field keys or WordPress code in this document. PHP checks unique all image IDs, evidence refs, meaning of cost/duration and mapping to approved ACF bindings. v0.6.2: relations object required; each list may be empty (no link = draft is still created).",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "post_type": {
      "const": "works"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "overview",
          "client_request",
          "work_done",
          "area",
          "duration",
          "cost",
          "materials",
          "building_type",
          "notes",
          "floor_plan",
          "site_area",
          "building_age",
          "parts",
          "work_type",
          "customer_voice"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "provided",
              "inferred_from_image",
              "unknown"
            ]
          },
          "source": {
            "enum": [
              "user_input",
              "photo",
              "editor_review",
              "unknown"
            ]
          },
          "evidence_image_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "value",
          "status",
          "source",
          "evidence_image_ids"
        ],
        "additionalProperties": false
      },
      "minProperties": 3
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "integer",
            "minimum": 1
          },
          "original_position": {
            "type": "integer",
            "minimum": 0
          },
          "phase": {
            "enum": [
              "before",
              "during",
              "after",
              "unknown"
            ]
          },
          "description": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "related_image_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "included": {
            "type": "boolean"
          },
          "uncertain": {
            "type": "boolean"
          }
        },
        "required": [
          "attachment_id",
          "original_position",
          "phase",
          "description",
          "related_image_ids",
          "included",
          "uncertain"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "introduction",
              "before",
              "during",
              "after",
              "comparison",
              "feature",
              "summary",
              "custom"
            ]
          },
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "image_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "evidence_image_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "node_id",
          "kind",
          "heading",
          "body",
          "image_ids",
          "evidence_image_ids"
        ],
        "additionalProperties": false
      }
    },
    "layout_intent": {
      "type": "object",
      "properties": {
        "hero": {
          "enum": [
            "single",
            "gallery",
            "before_after",
            "auto"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "hero"
      ],
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "h1": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "status": {
      "const": "proposal"
    },
    "relations": {
      "description": "WP内の関連付け（お客様の声・担当スタッフ・監修者）。AIは推測せず、利用者または編集者が選んだ投稿IDのみ。空配列は「紐付けなし」で、その場合は該当フィールドに書き込まない。ACFのmin/max・投稿タイプ・公開状態はPHPで実定義と照合する。",
      "type": "object",
      "properties": {
        "customer_voice_post_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "staff": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "post_id": {
                "type": "integer",
                "minimum": 1
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "post_id",
              "comment"
            ],
            "additionalProperties": false
          }
        },
        "supervisor_post_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "customer_voice_post_ids",
        "staff",
        "supervisor_post_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "document_id",
    "source_request_id",
    "post_type",
    "title",
    "summary",
    "facts",
    "images",
    "sections",
    "layout_intent",
    "status",
    "relations"
  ],
  "additionalProperties": false
}
