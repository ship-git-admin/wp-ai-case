{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image analysis output",
  "$id": "https://example.invalid/wp-ai-case/v0.5/image_analysis.schema.json",
  "description": "PHP validates the image_analysis attachment_id set equals the requested input set, exactly once each; related IDs must also be in the input set.",
  "type": "object",
  "required": [
    "image_analysis",
    "article_facts"
  ],
  "additionalProperties": false,
  "properties": {
    "image_analysis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "enum": [
              "before",
              "during",
              "after",
              "unknown"
            ]
          },
          "description": {
            "type": "string"
          },
          "related_image_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "string"
          },
          "uncertain": {
            "type": "boolean"
          },
          "uncertain_reason": {
            "type": "string"
          }
        },
        "required": [
          "attachment_id",
          "phase",
          "description",
          "related_image_ids",
          "evidence",
          "uncertain"
        ],
        "additionalProperties": false
      }
    },
    "article_facts": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "body_outline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "summary",
        "body_outline"
      ],
      "additionalProperties": false
    }
  }
}
